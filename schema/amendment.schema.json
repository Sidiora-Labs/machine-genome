{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mgs:schema:0.1.1:amendment",
  "title": "Machine Genome Controller Amendment",
  "type": "object",
  "required": [
    "mgs", "recordType", "gene", "seq", "prev", "amendmentType",
    "timestamp", "controller", "body"
  ],
  "properties": {
    "mgs": { "const": "0.1.1" },
    "recordType": { "const": "amendment" },
    "gene": { "$ref": "#/$defs/digest" },
    "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "prev": { "$ref": "#/$defs/digest" },
    "amendmentType": { "type": "string", "minLength": 1 },
    "timestamp": { "$ref": "#/$defs/timestamp" },
    "controller": { "$ref": "#/$defs/did" },
    "body": { "type": "object" },
    "proof": { "$ref": "#/$defs/proof" }
  },
  "additionalProperties": false,
  "$defs": {
    "did": { "type": "string", "pattern": "^did:[a-z0-9]+:[^#?]+$" },
    "didUrl": { "type": "string", "pattern": "^did:[a-z0-9]+:[^#?]+#[^#]+$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "digest": { "type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$" },
    "proof": {
      "type": "object",
      "required": ["type", "cryptosuite", "created", "verificationMethod", "proofPurpose", "proofValue"],
      "properties": {
        "type": { "const": "DataIntegrityProof" },
        "cryptosuite": { "const": "eddsa-jcs-2022" },
        "created": { "$ref": "#/$defs/timestamp" },
        "verificationMethod": { "$ref": "#/$defs/didUrl" },
        "proofPurpose": { "const": "assertionMethod" },
        "proofValue": { "type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$" }
      },
      "additionalProperties": false
    }
  }
}
