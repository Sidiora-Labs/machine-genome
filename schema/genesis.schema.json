{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mgs:schema:0.2.0:genesis",
  "title": "Machine Genome Genesis Record",
  "type": "object",
  "required": ["mgs", "recordType", "identity", "parentage", "controller", "genesis"],
  "properties": {
    "mgs": { "enum": ["0.1.1", "0.2.0"] },
    "recordType": { "const": "genesis" },
    "identity": {
      "type": "object",
      "required": ["name", "namespace", "subjectType", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "subjectType": {
          "enum": ["model", "agent", "agent-class", "agent-instance", "harness", "dataset"]
        },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "did": { "$ref": "#/$defs/did" },
        "createdDate": { "$ref": "#/$defs/date" },
        "agentName": {
          "type": "object",
          "required": ["given"],
          "properties": {
            "given": { "type": "string", "minLength": 1, "maxLength": 32 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "parentage": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "controller": {
      "type": "object",
      "required": ["did", "genesisKeyId"],
      "properties": {
        "did": { "$ref": "#/$defs/did" },
        "genesisKeyId": { "$ref": "#/$defs/didUrl" }
      },
      "additionalProperties": false
    },
    "genesis": {
      "type": "object",
      "required": ["timestamp", "artifactCommitments"],
      "properties": {
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "registrar": { "$ref": "#/$defs/did" },
        "artifactCommitments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "hash", "present"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "hash": { "$ref": "#/$defs/digest" },
              "present": { "type": "boolean" },
              "uri": { "type": "string", "format": "uri" },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" },
      "maxItems": 128
    },
    "trainingData": {
      "type": "array",
      "items": { "$ref": "#/$defs/trainingData" },
      "maxItems": 128
    },
    "model": {
      "type": "object",
      "required": ["provider", "modelId", "foundation"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "providers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "modelId": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "contextWindow": { "type": "integer", "minimum": 1 },
        "foundation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "proof": { "$ref": "#/$defs/proof" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mgs": { "const": "0.2.0" } }, "required": ["mgs"] },
      "then": {
        "required": ["capabilities", "trainingData"],
        "properties": { "identity": { "required": ["createdDate"] } }
      }
    },
    {
      "if": {
        "properties": {
          "mgs": { "const": "0.2.0" },
          "identity": { "properties": { "subjectType": { "enum": ["agent", "agent-instance"] } }, "required": ["subjectType"] }
        },
        "required": ["mgs", "identity"]
      },
      "then": { "properties": { "identity": { "required": ["agentName"] } } }
    },
    {
      "if": {
        "properties": {
          "mgs": { "const": "0.2.0" },
          "identity": { "properties": { "subjectType": { "const": "model" } }, "required": ["subjectType"] }
        },
        "required": ["mgs", "identity"]
      },
      "then": { "required": ["model"] }
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#?]+$"
    },
    "didUrl": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#?]+#[^#]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "proof": {
      "type": "object",
      "required": ["type", "cryptosuite", "created", "verificationMethod", "proofPurpose", "proofValue"],
      "properties": {
        "type": { "const": "DataIntegrityProof" },
        "cryptosuite": { "const": "eddsa-jcs-2022" },
        "created": { "$ref": "#/$defs/timestamp" },
        "verificationMethod": { "$ref": "#/$defs/didUrl" },
        "proofPurpose": { "const": "assertionMethod" },
        "proofValue": { "type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$" }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["id", "name", "level"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "level": { "enum": ["basic", "working", "advanced", "expert"] },
        "description": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/digest" } }
      },
      "additionalProperties": false
    },
    "trainingData": {
      "type": "object",
      "required": ["stage", "name", "disclosure"],
      "properties": {
        "stage": { "enum": ["pretraining", "post-training", "fine-tuning", "reinforcement", "distillation", "runtime-learning", "other"] },
        "name": { "type": "string", "minLength": 1 },
        "disclosure": { "enum": ["full", "partial", "summary", "undisclosed", "unknown", "not-applicable"] },
        "description": { "type": "string" },
        "uri": { "type": "string", "format": "uri" },
        "digest": { "$ref": "#/$defs/digest" },
        "license": { "type": "string" },
        "dataCutoff": { "$ref": "#/$defs/date" }
      },
      "dependentRequired": { "uri": ["digest"] },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["edgeType", "authorized"],
      "properties": {
        "edgeType": {
          "enum": [
            "fine-tune-of", "distilled-from", "merge-of", "quantization-of",
            "model-instance-of", "scaffold-fork-of", "instance-of",
            "prompt-descendant-of", "ensemble-of", "trained-on", "successor-of", "powered-by"
          ]
        },
        "parentGene": { "$ref": "#/$defs/digest" },
        "authorized": { "type": "boolean" },
        "authorizationProof": { "$ref": "#/$defs/proof" },
        "unresolved": { "type": "boolean" },
        "externalRef": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "unresolved": { "const": true } }, "required": ["unresolved"] },
          "then": {
            "properties": { "authorized": { "const": false } },
            "required": ["externalRef"],
            "not": { "anyOf": [{ "required": ["parentGene"] }, { "required": ["authorizationProof"] }] }
          },
          "else": { "required": ["parentGene"] }
        },
        {
          "if": { "properties": { "authorized": { "const": true } } },
          "then": { "required": ["authorizationProof"] },
          "else": { "not": { "required": ["authorizationProof"] } }
        }
      ],
      "additionalProperties": false
    }
  }
}
